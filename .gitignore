# Secrets
server/.env

# Dependencies
node_modules/
server/node_modules/
client/node_modules/

# Build output
client/dist/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Large data — knowledge base is regenerable, keep out of git
server/knowledge-base.json
server/knowledge-cache.json
server/build-progress.json

# Loose PDFs dropped at the top of source/ for a one-off build.
#
# Deliberately NOT recursive: source/library/ is a curated reading list that is
# meant to be committed, PDFs included. A `*` does not cross a `/`, so this
# rule stops at the top level, which is the intent — do not "fix" it into
# source/**/*.pdf without moving the library somewhere else first.
source/*.pdf

# Rescued/derived knowledge data — large binaries, regenerable, may be
# source-derived. Back these up outside git (see ARCHITECTURE_PLAN.md Phase 0).
data/

# Local editor state — not part of the project
.claude/
