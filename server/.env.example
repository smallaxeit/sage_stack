# ─── Store ────────────────────────────────────────────────────────────────────
# Where SageStack's own subjects live. "files" needs no database at all.
#   KB_STORE=files      JSON + a binary vector sidecar under data/subjects/
#   KB_STORE=postgres   local Postgres + pgvector, one schema per subject
KB_STORE=postgres
DATABASE_URL=postgresql://sage:sage@localhost:5433/sagestack

# ─── ask_cooter corpus (read-only) ────────────────────────────────────────────
# The softail subject connects to this existing database in place rather than
# copying it. Referenced from subjects/softail/subject.json by name.
ASKCOOTER_DATABASE_URL=postgresql://user:pass@localhost:5433/askcooter
ASKCOOTER_IMAGE_DIR=C:/path/to/AskCooter/data/pages

# ─── Supabase (legacy — needed ONLY to export the old theology corpus) ────────
# Phase 0 of ARCHITECTURE_PLAN.md. Fill these in, then run:
#     npm run export:supabase
# It dumps chunks + embeddings + concept_map to data/exports/ so the theology
# vectors survive leaving Supabase. Nothing else in the app reads these.
# Use the service_role key, NOT the anon key — anon cannot read every row.
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# ─── API keys ─────────────────────────────────────────────────────────────────
# Chat answers, and the optional per-chunk analysis during ingestion.
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings. Without one of these, documents can be ingested but NOT searched.
# Alternative with no key and no cost:
#     EMBED_DRIVER=local
#     npm --prefix server install @huggingface/transformers
# Note the local models are 384/768-dim, so switching is a full re-embed.
VOYAGE_API_KEY=pa-...
# EMBED_DRIVER=voyage

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# Which subject to serve when a request doesn't name one. With more than one
# subject defined and this unset, requests must name a subject explicitly.
# DEFAULT_SUBJECT=theology

# Set to require x-admin-key on admin and upload routes. Unset = open locally.
# ADMIN_KEY=

# ─── Advanced / overrides ─────────────────────────────────────────────────────
# Most of these are better set per subject in subjects/<slug>/subject.json,
# where they belong to one knowledge area rather than the whole server. They
# exist as env vars mainly for one-off runs and tests.

# Embedding model and dimension, when not set by a subject profile.
# Changing either means re-embedding: vectors are not comparable across models.
# VOYAGE_MODEL=voyage-3.5
# EMBED_DIM=1024

# Local embedder model (EMBED_DRIVER=local). 384 or 768 dims, not 1024.
# LOCAL_EMBED_MODEL=Xenova/all-MiniLM-L6-v2

# Where the files store and the subject profiles live. Only worth setting to
# run against a scratch copy without touching the real one.
# KB_FILES_ROOT=./data/subjects
# SUBJECTS_ROOT=./subjects

# Postgres tests read this, deliberately NOT DATABASE_URL, so a routine
# `npm test` can never write into a working database.
# TEST_DATABASE_URL=postgresql://sage:sage@localhost:5433/sagestack
